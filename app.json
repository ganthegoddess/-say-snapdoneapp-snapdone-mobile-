{
  "expo": {
    "name": "SnapDone",
    "slug": "snapdone",
    "version": "0.1.0",
    "owner": "snapdoneapp",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "snapdone",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "6",
      "supportsTablet": true,
      "bundleIdentifier": "com.snapdoneapp.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SnapDone uses your camera to capture receipts, flyers, notes, and other documents to turn them into actions.",
        "NSPhotoLibraryUsageDescription": "SnapDone accesses your photo library to process screenshots, photos, and documents into actions.",
        "NSMicrophoneUsageDescription": "SnapDone uses your microphone to capture voice notes and turn them into reminders and tasks.",
        "NSRemindersUsageDescription": "SnapDone creates reminders from your captured documents and voice notes.",
        "NSCalendarsUsageDescription": "SnapDone adds events from flyers, appointment cards, and travel confirmations to your calendar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0891B2"
      },
      "package": "com.snapdoneapp.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-audio",
      "expo-calendar",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#0891B2"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "newArchEnabled": true
          },
          "ios": {
            "deploymentTarget": "17.0",
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {},
        "projectId": "63ac5dcc-bee8-4522-90d9-05587e01c866"
      }
    }
  }
}